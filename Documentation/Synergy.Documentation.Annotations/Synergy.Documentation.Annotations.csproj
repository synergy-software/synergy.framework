<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RunCodeAnalysis>false</RunCodeAnalysis>
        <IsPackable>true</IsPackable>
        <PackageVersion>$(Version)</PackageVersion>
        <Title>Synergy.Documentation.Annotations</Title>
        <Authors>Synergy Marcin Celej</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/synergy-software/synergy.framework/tree/master/Documentation/Synergy.Documentation.Annotations</PackageProjectUrl>
        <PackageIcon>synergy.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Description>Lightweight source annotations and fluent comment helpers for documenting code rationale and associating types with their source files.</Description>
        <Copyright>Copyright © Synergy Marcin Celej 2024</Copyright>
        <PackageTags>documentation docs-as-code annotations comments</PackageTags>
        <LangVersion>10</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <ImplicitUsings>true</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DefineConstants>TRACE;INTERNALS</DefineConstants>
        <DocumentationFile>bin\Debug\Synergy.Documentation.Annotations.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DefineConstants>TRACE;INTERNALS</DefineConstants>
        <DocumentationFile>bin\Release\Synergy.Documentation.Annotations.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="synergy.png" Pack="true" PackagePath="" />
        <None Include="license.txt" Pack="true" PackagePath="" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
